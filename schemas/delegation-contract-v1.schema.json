{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-supervisor.local/schemas/delegation-contract-v1.schema.json",
  "title": "DelegationContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "unit",
    "role",
    "objective",
    "authority",
    "inputs",
    "write_scope",
    "expected_effect",
    "acceptance",
    "checks",
    "stop_conditions"
  ],
  "properties": {
    "schema": { "type": "string", "const": "DelegationContractV1" },
    "unit": { "$ref": "#/$defs/unit" },
    "role": {
      "type": "string",
      "enum": ["implementer", "verifier", "repair", "documenter"]
    },
    "objective": { "$ref": "#/$defs/text" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grants", "source"],
      "properties": {
        "grants": { "$ref": "#/$defs/nonEmptyTextList" },
        "source": { "$ref": "#/$defs/nonEmptyTextList" }
      }
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/inputPath" }
    },
    "write_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safeRelativePath" }
    },
    "expected_effect": {
      "type": "string",
      "enum": ["mutation_required", "mutation_allowed", "read_only"]
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^A[1-9][0-9]*$" },
          "outcome": { "$ref": "#/$defs/text" },
          "evidence": { "$ref": "#/$defs/nonEmptyTextList" }
        }
      }
    },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "stop_conditions": { "$ref": "#/$defs/nonEmptyTextList" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "role": { "const": "verifier" } },
        "required": ["role"]
      },
      "then": {
        "properties": { "expected_effect": { "const": "read_only" } }
      }
    },
    {
      "if": {
        "properties": { "expected_effect": { "const": "read_only" } },
        "required": ["expected_effect"]
      },
      "then": {
        "properties": { "write_scope": { "type": "array", "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": {
          "expected_effect": { "enum": ["mutation_required", "mutation_allowed"] }
        },
        "required": ["expected_effect"]
      },
      "then": {
        "properties": { "write_scope": { "type": "array", "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "nonEmptyTextList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "inputPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))[A-Za-z0-9_@+=.-](?:[A-Za-z0-9_@+=. -]*[A-Za-z0-9_@+=-])?(?:/[A-Za-z0-9_@+=.-](?:[A-Za-z0-9_@+=. -]*[A-Za-z0-9_@+=-])?)*$"
    }
  }
}
