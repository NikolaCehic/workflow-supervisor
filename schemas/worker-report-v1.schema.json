{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-supervisor.local/schemas/worker-report-v1.schema.json",
  "title": "WorkerReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "role",
    "unit_id",
    "summary",
    "changed_surfaces",
    "evidence",
    "checks_run",
    "skipped_checks",
    "findings",
    "blocking_question",
    "next_action",
    "verification_environment",
    "outcome_evaluations",
    "adapter",
    "guard",
    "reason",
    "stdout_excerpt",
    "stderr_excerpt"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "WorkerReportV1"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED"]
    },
    "role": {
      "type": "string",
      "enum": ["implementer", "verifier", "repair", "documenter"]
    },
    "unit_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "changed_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceEntry" }
    },
    "checks_run": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceEntry" }
    },
    "skipped_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceEntry" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceEntry" }
    },
    "blocking_question": {
      "type": ["string", "null"]
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verification_environment": {
      "anyOf": [
        { "$ref": "#/$defs/verificationEnvironment" },
        { "type": "null" }
      ]
    },
    "outcome_evaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/outcomeEvaluation" }
    },
    "adapter": {
      "anyOf": [
        { "$ref": "#/$defs/adapterMeta" },
        { "type": "null" }
      ]
    },
    "guard": {
      "anyOf": [
        { "$ref": "#/$defs/guardMeta" },
        { "type": "null" }
      ]
    },
    "reason": {
      "type": ["string", "null"]
    },
    "stdout_excerpt": {
      "type": ["string", "null"]
    },
    "stderr_excerpt": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": { "properties": { "evidence": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "role": { "const": "verifier" } }, "required": ["role"] },
      "then": { "properties": { "changed_surfaces": { "type": "array", "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["PASS", "FAIL"] } }, "required": ["status"] },
      "then": { "properties": { "blocking_question": { "type": "null" } } }
    }
  ],
  "$defs": {
    "evidenceEntry": {
      "anyOf": [
        { "type": "string", "minLength": 1, "pattern": "\\S" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "detail"],
          "properties": {
            "kind": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "detail": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        }
      ]
    },
    "verificationCapability": {
      "type": "string",
      "enum": [
        "static_diff_inspection",
        "diff_inspection",
        "shell_command",
        "unit_test",
        "integration_test",
        "contract_test",
        "data_contract_test",
        "jsdom_render",
        "api_probe",
        "file_snapshot",
        "generated_html_snapshot",
        "component_tree_snapshot",
        "accessibility_tree_snapshot",
        "state_machine_test",
        "browser_snapshot",
        "human_required",
        "manual_review"
      ]
    },
    "capabilityList": {
      "type": "array",
      "items": { "$ref": "#/$defs/verificationCapability" }
    },
    "verificationEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shell",
        "filesystem",
        "git_diff",
        "browser",
        "playwright_mcp",
        "network",
        "capabilities",
        "limitations"
      ],
      "properties": {
        "shell": { "type": "boolean" },
        "filesystem": { "type": "boolean" },
        "git_diff": { "type": "boolean" },
        "browser": { "type": "boolean" },
        "playwright_mcp": { "type": "boolean" },
        "network": { "type": "boolean" },
        "capabilities": { "$ref": "#/$defs/capabilityList" },
        "limitations": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "adapterMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "command", "exit_code", "timed_out", "source", "schema_mode"],
      "properties": {
        "agent": { "type": ["string", "null"] },
        "command": {
          "anyOf": [
            {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            { "type": "null" }
          ]
        },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "source": { "type": ["string", "null"] },
        "schema_mode": {
          "anyOf": [
            { "type": "string", "enum": ["file", "json"] },
            { "type": "null" }
          ]
        }
      }
    },
    "guardMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_surface_violations", "role_violations", "warnings", "observed_changed_surfaces"],
      "properties": {
        "allowed_surface_violations": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "role_violations": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "observed_changed_surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "evidenceStrength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strongest_possible", "strongest_available", "limitation"],
      "properties": {
        "strongest_possible": { "$ref": "#/$defs/capabilityList" },
        "strongest_available": { "$ref": "#/$defs/capabilityList" },
        "limitation": { "type": ["string", "null"] }
      }
    },
    "outcomeEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_requirement",
        "expected_outcome",
        "preferred_verification",
        "available_verification",
        "evidence_strength",
        "evidence",
        "invalid_pass_conditions",
        "verdict",
        "limitation",
        "capability_limitations",
        "required_external_check",
        "finding"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "source_requirement": { "$ref": "#/$defs/nonEmptyString" },
        "expected_outcome": { "$ref": "#/$defs/nonEmptyString" },
        "preferred_verification": { "$ref": "#/$defs/capabilityList" },
        "available_verification": { "$ref": "#/$defs/capabilityList" },
        "evidence_strength": { "$ref": "#/$defs/evidenceStrength" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceEntry" }
        },
        "invalid_pass_conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "verdict": {
          "type": "string",
          "enum": ["PASS", "FAIL", "BLOCKED", "CONDITIONAL_PASS"]
        },
        "limitation": { "type": ["string", "null"] },
        "capability_limitations": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "required_external_check": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "finding": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "PASS" } }, "required": ["verdict"] },
          "then": { "properties": { "evidence": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  }
}
