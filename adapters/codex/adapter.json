{
  "agent": "codex",
  "status": "native",
  "defaultTarget": "~/.agents/skills",
  "projectTarget": "<project>/.agents/skills",
  "metadata": "agents/openai.yaml",
  "invocation": "Use $workflow-supervisor ...",
  "delegate": {
    "command": ["codex", "exec", "--json", "--ephemeral", "--skip-git-repo-check"],
    "versionArgs": ["--version"],
    "promptMode": "stdin",
    "stdinArg": "-",
    "schemaMode": "file",
    "schemaFlag": "--output-schema",
    "roleArgs": {
      "implementer": ["--sandbox", "workspace-write"],
      "verifier": ["--sandbox", "read-only"],
      "repair": ["--sandbox", "workspace-write"],
      "documenter": ["--sandbox", "workspace-write"]
    }
  }
}
